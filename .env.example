# Copy to .env and fill in for local `vercel dev` testing. In production,
# set these as Environment Variables in the Vercel project settings instead —
# see README.md for the full setup walkthrough.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the service account's JSON key, quoted,
# with literal \n for line breaks (that's how Vercel's env var UI stores it).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-id-from-your-sheet-url
