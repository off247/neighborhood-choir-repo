# Copy to .env and fill in for local `vercel dev` testing. In production,
# set these as Environment Variables in the Vercel project settings instead —
# see README.md for the full setup walkthrough (apps-script/Code.gs).

# The Web App URL from deploying apps-script/Code.gs (ends in /exec).
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Optional but recommended: any random string, must match the 'SECRET'
# script property set on the Apps Script project. Leave both unset to skip
# this check entirely.
APPS_SCRIPT_SECRET=some-long-random-string
