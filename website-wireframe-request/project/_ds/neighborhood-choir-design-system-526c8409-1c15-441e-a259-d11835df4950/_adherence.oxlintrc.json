{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Merriweather|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Merriweather, Source Sans 3."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-2",
      "--bg",
      "--bg-elevated",
      "--color-dusk",
      "--color-dusk-soft",
      "--color-harriet",
      "--color-harriet-deep",
      "--color-harriet-soft",
      "--color-hearth",
      "--color-hearth-deep",
      "--color-hearth-soft",
      "--color-ink",
      "--color-ink-quiet",
      "--color-ink-soft",
      "--color-page",
      "--color-paper",
      "--color-paper-edge",
      "--color-porchlight",
      "--color-porchlight-deep",
      "--color-porchlight-soft",
      "--fg",
      "--fg-muted",
      "--fg-quiet",
      "--font-sans",
      "--font-serif",
      "--highlight",
      "--lh-loose",
      "--lh-normal",
      "--lh-snug",
      "--lh-tight",
      "--max-content",
      "--max-page",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--rule",
      "--shadow-inset-rule",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--size-body",
      "--size-caption",
      "--size-display",
      "--size-h1",
      "--size-h2",
      "--size-h3",
      "--size-h4",
      "--size-overline",
      "--size-small",
      "--space-1",
